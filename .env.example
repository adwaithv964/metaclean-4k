PORT=8787
HOST=127.0.0.1
MAX_UPLOAD_BYTES=104857600
MAX_PIXELS=100000000
MAX_PROCESS_MS=30000
TEMP_RETENTION_MS=300000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
NODE_ENV=development
# Security (new)
SOCKET_TIMEOUT_MS=30000
MAX_MULTIPART_PARTS=10
# Comma-separated list of proxy IPs/ranges to trust for X-Forwarded-For.
# Set this to your load balancer's IP on Render / cloud platforms.
# Leave empty to use defaults (loopback only).
TRUSTED_PROXY_IPS=
